# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Telegram ID
ADMIN_TELEGRAM_ID=your_admin_telegram_id

# Database
DATABASE_URL=postgresql+asyncpg://vpn_user:vpn_password@localhost:5432/vpn_bot
POSTGRES_PASSWORD=vpn_password

# 3x-ui Panel
XUI_PANEL_URL=https://your-server.com:2053
XUI_USERNAME=admin
XUI_PASSWORD=your_password

# Crypto Wallets
CRYPTO_WALLET_BTC=bc1qxy2kgdygjrsqtzq2n0yrf2493p83kkfjhx0wlh
CRYPTO_WALLET_USDT=TQn9Y2khEsLMJUiwh8i6D7nJ4WQJ6KzT3S

# Payment amounts (in USD)
PRICE_1_DAY=5
PRICE_1_WEEK=15
PRICE_1_MONTH=25
PRICE_6_MONTHS=120
PRICE_1_YEAR=200

# VPN Settings
VPN_INBOUND_ID=1
DEFAULT_DATA_LIMIT_GB=1000

# Security Settings
MAX_LOGIN_ATTEMPTS=3
SESSION_TIMEOUT_MINUTES=30
RATE_LIMIT_REQUESTS_PER_MINUTE=10

# Monitoring Settings
ENABLE_MONITORING=true
MONITORING_INTERVAL_SECONDS=300
ALERT_EMAIL=admin@your-domain.com

# Backup Settings
ENABLE_AUTO_BACKUP=true
BACKUP_RETENTION_DAYS=30

# SSL/TLS Settings
SSL_CERT_PATH=/etc/ssl/certs/your-domain.crt
SSL_KEY_PATH=/etc/ssl/private/your-domain.key

# Domain Settings
DOMAIN_NAME=your-domain.com

# Grafana Settings
GRAFANA_PASSWORD=admin123